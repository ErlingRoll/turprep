# Leave empty for local development so Vite proxies /api to the backend.
VITE_API_BASE_URL=

# Optional production origin used for OAuth redirects. If empty, the current
# browser origin is used.
VITE_APP_URL=

# Supabase browser configuration. The publishable key is safe to expose in
# browser code; never use a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser-visible Google Maps JavaScript API key. Restrict this key by HTTP
# referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-api-key
# Optional Google Maps map ID used by AdvancedMarkerElement. DEMO_MAP_ID is
# used when this is empty.
VITE_GOOGLE_MAPS_MAP_ID=
